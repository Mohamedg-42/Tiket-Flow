<script>
    // ==============================================================================
    // LOGIQUE INTERACTIVE (Alpine.js + Vanilla JS)
    // ==============================================================================

    let selectedSeats = {};

    function openEventModal(button) {
        const data = button.dataset;
        document.getElementById('clientModalEventName').textContent = data.eventName;
        document.getElementById('clientModalDate').textContent = data.eventDate;
        document.getElementById('clientModalTime').textContent = data.eventTime;
        document.getElementById('clientModalPlace').textContent = data.eventPlace;

        const descEl = document.getElementById('clientModalDesc');
        descEl.textContent = data.eventDesc || '';
        descEl.style.display = data.eventDesc ? 'block' : 'none';

        document.getElementById('clientModalCapacity').textContent = (Number(data.eventStock) || 0) + ' place(s) sur ' + (Number(data.eventCapacity) || 0);

        document.getElementById('clientModalEventId').value = data.eventId;
        document.getElementById('clientOrderForm').action = 'commander.php?id=' + data.eventId;

        const tiersContainer = document.getElementById('ticket-tiers-container');
        tiersContainer.innerHTML = '';
        const options = JSON.parse(data.ticketOptions || '[]');

        options.forEach((ticket, index) => {
            const stock = Math.max(0, Number(ticket.quantite) - Number(ticket.quantite_vendue || 0));
            const isSoldOut = (stock <= 0);
            const row = document.createElement('div');
            row.className = 'flex justify-between items-center p-3 bg-slate-50 border border-line rounded-xl transition-all hover:bg-white hover:border-primary';
            row.innerHTML = `
                <div>
                    <strong class="block text-sm text-navy">${ticket.nom}</strong>
                    <div class="flex items-center gap-2 text-xs">
                        <span class="text-primary font-extrabold">${Number(ticket.prix).toLocaleString('fr-FR')} FCFA</span>
                        <span class="font-semibold ${isSoldOut ? 'text-red-500' : 'text-green-600'}">${isSoldOut ? 'Épuisé' : stock + ' restante(s)'}</span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="changeQty(${ticket.id}, -1)" ${isSoldOut ? 'disabled' : ''} class="w-8 h-8 bg-white border border-line rounded-lg flex items-center justify-center hover:bg-primary-soft transition-all">-</button>
                    <input type="number" name="tickets[${ticket.id}]" id="qty_input_${ticket.id}" class="w-12 text-center p-1 border border-line rounded-lg text-sm font-bold"
                           min="0" max="${Math.min(10, stock)}" value="${index === 0 && !isSoldOut ? 1 : 0}"
                           data-prix="${ticket.prix}" data-frais-place="${ticket.frais_place || 0}" data-stock="${stock}"
                           oninput="updateMultiTicketTotal()" ${isSoldOut ? 'disabled' : ''}>
                    <button type="button" onclick="changeQty(${ticket.id}, 1)" ${isSoldOut ? 'disabled' : ''} class="w-8 h-8 bg-white border border-line rounded-lg flex items-center justify-center hover:bg-primary-soft transition-all">+</button>
                </div>
            `;
            tiersContainer.appendChild(row);
        });

        updateMultiTicketTotal();
        Alpine.store('modals').toggleEvent(true);
    }

    function changeQty(ticketId, delta) {
        const input = document.getElementById('qty_input_' + ticketId);
        if (!input || input.disabled) return;
        let val = Number(input.value) || 0;
        const max = Number(input.max) || 10;
        const min = Number(input.min) || 0;
        val = Math.min(max, Math.max(min, val + delta));
        input.value = val;
        updateMultiTicketTotal();
    }

    function updateMultiTicketTotal() {
        const inputs = document.querySelectorAll('.ticket-qty-input:not(:disabled)');
        let totalCount = 0;
        let totalPrice = 0;
        inputs.forEach(input => {
            const qty = Number(input.value) || 0;
            const prix = Number(input.dataset.prix) || 0;
            totalCount += qty;
            totalPrice += (qty * prix);
        });
        document.getElementById('clientModalTicketsCount').textContent = totalCount + ' place(s) sélectionnée(s)';
        document.getElementById('clientModalTotal').textContent = totalPrice.toLocaleString('fr-FR') + ' FCFA';
        const submitBtn = document.getElementById('btnSubmitOrder');
        if (submitBtn) submitBtn.disabled = (totalCount <= 0);
    }

    async function toggleVote(e, btn) {
        e.stopPropagation();
        const eventId = btn.dataset.eventId;
        try {
            const res = await fetch('vote-event.php', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'event_id=' + encodeURIComponent(eventId)
            });
            const data = await res.json();
            if (data.error) { alert(data.error); return; }
            if (data.needs_payment) {
                openVoteModal(eventId, data.event_nom, data.prix, data.candidats || [], data.type_vote, data.vote_question);
                return;
            }
            if (data.redirect) { window.location.href = data.redirect; return; }
            btn.classList.toggle('voted', data.voted);
            btn.innerHTML = data.voted ? '<i class="fa-solid fa-thumbs-up"></i> Voté' : '<i class="fa-solid fa-thumbs-up"></i> Vote';
        } catch (err) { alert("Erreur lors du vote."); }
    }

    function openVoteModal(eventId, eventNom, prix, candidats, typeVote, voteQuestion) {
        document.getElementById('voteModalEventName').innerHTML = typeVote === 'realisation_evenement' && voteQuestion
            ? `<span class="block text-xs text-muted uppercase font-bold">Vote de Réalisation : ${eventNom}</span><strong class="text-navy">« ${voteQuestion} »</strong>`
            : eventNom;
        document.getElementById('voteModalPrix').textContent = Number(prix).toLocaleString('fr-FR') + ' FCFA';

        const candWrapper = document.getElementById('voteModalCandidatsWrapper');
        const candList = document.getElementById('voteModalCandidatsList');
        if (candidats.length > 0) {
            candWrapper.style.display = 'block';
            candList.innerHTML = candidats.map(c => `
                <div class="flex items-center gap-3 p-3 bg-white border border-line rounded-xl cursor-pointer hover:border-primary transition-all" onclick="this.querySelector('input').click()">
                    <input type="checkbox" class="vote-candidat-cb accent-primary" value="${c.id}" onchange="updateVoteModalTotal()">
                    <img src="${c.photo || 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=400&q=80'}" class="w-10 h-10 rounded-lg object-cover">
                    <div class="flex-1">
                        <div class="text-sm font-bold text-navy">${c.nom}</div>
                        <div class="text-[10px] text-muted">${c.description || ''}</div>
                    </div>
                </div>
            `).join('');
        } else {
            candWrapper.style.display = 'none';
        }
        updateVoteModalTotal();
        Alpine.store('modals').toggleVote(true);
    }

    function updateVoteModalTotal() {
        const selected = document.querySelectorAll('.vote-candidat-cb:checked');
        const count = selected.length;
        const prixText = document.getElementById('voteModalPrix').textContent;
        const prix = Number(prixText.replace(/\s/g, '').replace(' FCFA', ''));
        const total = count * prix;
        document.getElementById('voteModalChoicesCount').textContent = count + ' sélectionné(s)';
        document.getElementById('voteModalTotalDetail').textContent = count + ' choix × ' + prix.toLocaleString('fr-FR') + ' F';
        document.getElementById('voteModalTotalAmount').textContent = total.toLocaleString('fr-FR') + ' FCFA';
        document.getElementById('votePaySubmit').disabled = (count === 0);
    }

    function openCotisationModal(button) {
        document.getElementById('cotCampagneId').value = button.dataset.campagneId || '';
        document.getElementById('cotisationModalCampagneName').textContent = button.dataset.campagneTitre || 'Contribution générale';
        const motivationEl = document.getElementById('cotisationModalMotivation');
        motivationEl.textContent = button.dataset.campagneMotivation || '';
        motivationEl.style.display = button.dataset.campagneMotivation ? 'block' : 'none';
        Alpine.store('modals').toggleCotisation(true);
    }

    function setCotisation(montant) {
        const input = document.getElementById('cot_montant');
        if (input) input.value = montant;
    }

    async function submitVotePayment(e) {
        e.preventDefault();
        const eventId = document.getElementById('voteModalEventId')?.value;
        if (!eventId) return false;
        const selected = Array.from(document.querySelectorAll('.vote-candidat-cb:checked')).map(cb => cb.value);
        let body = 'event_id=' + eventId + '&phase=2';
        if (selected.length > 0) body += '&candidat_ids=' + selected.join(',');
        const res = await fetch('vote-event.php', { method: 'POST', headers: { 'Content-Type': 'application/x-www-form-urlencoded' }, body });
        const data = await res.json();
        if (data.redirect) window.location.href = data.redirect; else alert(data.error);
        return false;
    }

    document.addEventListener('alpine:init', () => {
        Alpine.store('modals', {
            eventOpen: false,
            cotisationOpen: false,
            voteOpen: false,
            toggleEvent(val) { this.eventOpen = val },
            toggleCotisation(val) { this.cotisationOpen = val },
            toggleVote(val) { this.voteOpen = val }
        });
    });
</script>

