// 2. Requête SQL Événements
$sql = "SELECT * FROM events WHERE statut = 'actif'";
$params = [];
if (!empty($q)) {
    $sql .= " AND (nom LIKE ? OR description LIKE ?)";
    $params[] = "%$q%";
    $params[] = "%$q%";
}
if (!empty($lieu)) {
    $sql .= " AND lieu LIKE ?";
    $params[] = "%$lieu%";
}
if (!empty($categorie) && $categorie !== 'Toutes') {
    $sql .= " AND categorie = ?";
    $params[] = $categorie;
}
