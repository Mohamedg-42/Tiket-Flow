# ==============================================================================
# CONFIGURATION APACHE & RÉÉCRITURE D'URL (CLEAN URLS SANS .PHP)
# ==============================================================================

Options -MultiViews +FollowSymLinks

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirection propre de index.php vers le dossier parent (/)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?index\.php[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L,NE]

    # 2. Redirection 301 externe des fichiers .php vers l'URL sans extension
    # (Exclut les scripts d'installation et les endpoints AJAX internes)
    RewriteCond %{REQUEST_METHOD} !POST
    RewriteCond %{THE_REQUEST} !/ajax/ [NC]
    RewriteCond %{REQUEST_URI} !^/installer_postgres\.php$
    RewriteCond %{THE_REQUEST} \s/+(.*?/)?([^/?\s]+)\.php[\s?] [NC]
    RewriteRule ^ /%1%2 [R=301,L,NE]

    # 3. Réécriture conviviale pour les événements par slug (aucun ID visible dans l'URL)
    RewriteRule ^(?:client/)?evenement/([a-zA-Z0-9_-]+)/?$ client/evenement.php?slug=$1 [L,QSA]
    RewriteRule ^evenement/?$ client/evenement.php [L,QSA]

    # 4. Réécriture interne transparente : mapper l'URL sans extension vers son fichier .php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>

# ==============================================================================
# OPTIMISATION DE PERFORMANCE & SÉCURITÉ
# ==============================================================================

<IfModule mod_headers.c>
    # 1. Mise en cache des ressources statiques immuables (30 jours)
    <FilesMatch "\.(ico|pdf|flv|jpg|jpeg|png|gif|webp|js|css|swf|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # 2. Sécurité des types MIME
    Header set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    # Compression GZIP des types texte
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml
</IfModule>

# Activation de la compression native PHP si disponible
<IfModule mod_php.c>
    php_flag zlib.output_compression on
    php_value zlib.output_compression_level 5
</IfModule>
<IfModule mod_php7.c>
    php_flag zlib.output_compression on
    php_value zlib.output_compression_level 5
</IfModule>
<IfModule mod_php8.c>
    php_flag zlib.output_compression on
    php_value zlib.output_compression_level 5
</IfModule>
