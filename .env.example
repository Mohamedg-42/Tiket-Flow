# ==============================================================================
# TIKÉLI — Fichier de configuration exemple (.env.example)
# Copier ce fichier en .env et remplir les valeurs réelles
# NE PAS renseigner de vraies credentials dans ce fichier (il est commité)
# ==============================================================================

# --- Base de données PostgreSQL ---
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=ticket_platform
DB_USER=postgres
DB_PASS=VOTRE_MOT_DE_PASSE_POSTGRES

# --- Sécurité paiements (HMAC SHA-256) ---
# Générer une clé forte : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET_KEY=VOTRE_CLE_SECRETE_HMAC_SHA256_FORTE

# --- Clé d'accès à l'installateur (installer_postgres.php) ---
INSTALL_KEY=VOTRE_CLE_INSTALLATION

# --- Configuration SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=votre_email@gmail.com
SMTP_PASS=VOTRE_APP_PASSWORD_GMAIL
SMTP_FROM=votre_email@gmail.com
SMTP_FROM_NAME=Tikéli

# --- Application ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://votre-domaine.com

# --- Passerelle de Paiement Bictorys (Mobile Money & Cartes) ---
BICTORYS_ENV=test
BICTORYS_API_URL=https://api.test.bictorys.com
BICTORYS_API_KEY=test_public-VOTRE_CLE_PUBLIQUE
BICTORYS_PRIVATE_KEY=test_secret-VOTRE_CLE_PRIVEE
BICTORYS_WEBHOOK_SECRET=VOTRE_SECRET_WEBHOOK
BICTORYS_COUNTRY=CI

