# ==============================================================================
# PROTECTION DU DOSSIER DE SCRATCH / DÉBOGAGE (scratch/.htaccess)
# Bloque tout accès direct via HTTP pour empêcher la fuite d'informations
# ==============================================================================

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order Deny,Allow
    Deny from all
</IfModule>
